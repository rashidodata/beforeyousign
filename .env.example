# Private backend configuration. Never commit real credentials.
BYS_CORS_ORIGINS=https://rashidodata.github.io,http://localhost:8000,http://127.0.0.1:8000
BYS_USER_AGENT=BeforeYouSign/0.2 (contact: your-email@example.com)
# Photo and screenshot AI are disabled unless BOTH are configured securely.
# OPENAI_API_KEY=
# BYS_PHOTO_API_TOKEN=

# Optional licensed single-listing provider, disabled by default.
# Verify the provider's legal right to supply and license this content first.
# BYS_LISTING_PROVIDER=opendata
# BYS_PROVIDER_RIGHTS_CONFIRMED=1
# BYS_OPENDATA_API_KEY=
# BYS_IMPORT_OPERATOR_TOKEN=